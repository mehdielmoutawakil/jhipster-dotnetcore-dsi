using <%= namespace %>.Domain.Repositories.Interfaces;
using MediatR;
using System;
using System.Collections.Generic;
using System.IO;
using System.Threading;
using System.Threading.Tasks;
using Microsoft.Extensions.Configuration;
using System.IO;
using System;
using System.Runtime.CompilerServices;
using Serilog;
using Application.Utility;

namespace <%= namespace %>.Application.Commands
{
    /// <summary>
    /// <%= pascalizedEntityClass %> UploadFiles request class handler
    /// </summary>
    public class <%= pascalizedEntityClass %>UploadFilesCommandHandler : IRequestHandler<<%= pascalizedEntityClass %>UploadFilesCommand, List<string>>
    {
        private readonly I<%= pascalizedEntityClass %>Repository _<%= camelCasedEntityClass %>Repository;
        private readonly long _maxFileSize;
        private readonly string _baseImagePath;

        /// <summary>
        /// Variable used to get API method name, in async calls
        /// </summary>
        /// <param name="name"></param>
        /// <returns></returns>
        static string GetActualAsyncMethodName([CallerMemberName] string name = null) => name;

        /// <summary>
        /// <%= pascalizedEntityClass %>UploadFilesCommandHandler parameterized constructor
        /// </summary>
        /// <param name="activityRepository"></param>
        public <%= pascalizedEntityClass %>UploadFilesCommandHandler(I<%= pascalizedEntityClass %>Repository <%= camelCasedEntityClass %>Repository, IConfiguration configuration)
        {
            _<%= camelCasedEntityClass %>Repository = <%= camelCasedEntityClass %>Repository;

            // Read the max file size from configuration (in MB) and convert it to bytes
            try
            {
                var MaxFileSizeMB = int.Parse(configuration.GetSection("FileUploadSettings:MaxFileSizeMB").Value.ToString());
                _maxFileSize = MaxFileSizeMB * 1024 * 1024; // Convert MB to bytes
            }
            catch (Exception ex)
            {
                // Default allowed file size is 10MB
                _maxFileSize = 10 * 1024 * 1024; // Convert MB to bytes
            }

            // Read base image path from configuration
            try
            {
                _baseImagePath = configuration.GetSection("ImageSettings:BaseImagePath").Value;
            }
            catch (Exception ex)
            {
                // Default Base image url will be called uploads
                _baseImagePath = "uploads";
            }
        }

        /// <summary>
        /// Handler Method
        /// </summary>
        /// <param name="command"></param>
        /// <param name="cancellationToken"></param>
        /// <returns></returns>
        public async Task<List<string>> Handle(<%= pascalizedEntityClass %>UploadFilesCommand command, CancellationToken cancellationToken)
        {
            try 
            {
                // Validate the input
                if (command.Files == null || command.Files.Count == 0)
                {
                    throw new ArgumentException("No files provided.");
                }
    
                // Fetch the <%= camelCasedEntityClass %> from the repository
                var <%= camelCasedEntityClass %> = await _<%= camelCasedEntityClass %>Repository.GetByIdAsync(command.Id);
    
                if (<%= camelCasedEntityClass %> == null)
                {
                    throw new KeyNotFoundException("<%= camelCasedEntityClass %> not found.");
                }
    
                // Prepare the upload path
                var uploadPath = Path.Combine("wwwroot", _baseImagePath, "<%= pascalizedEntityClassPlural %>", command.Id.ToString());
                
                if (!Directory.Exists(uploadPath))
                {
                    Directory.CreateDirectory(uploadPath);
                }
    
                var imagePaths = new List<string>();
    
                // Process each file
                foreach (var file in command.Files)
                {
                    if (file.Length > 0)
                    {
                        // Check file size
                        if (file.Length > _maxFileSize)
                        {
                            // Handle file size limit exceeded
                            throw new InvalidOperationException($"File {file.FileName} exceeds the maximum allowed size of {_maxFileSize / (1024 * 1024)} MB.");
                        }
    
                        var fileName = Path.GetFileName(file.FileName);
                        var filePath = Path.Combine(uploadPath, fileName);
    
                        // Save the file
                        using (var stream = new FileStream(filePath, FileMode.Create))
                        {
                            await file.CopyToAsync(stream);
                            stream.Close();
                        }
    
                        imagePaths.Add(filePath);
                    }
                }
    
                // Return the list of image paths
                return imagePaths;
            }
            catch (Exception ex)
            {
                Log.Error(CommHelper.LogError(typeof(<%= pascalizedEntityClass %>UploadFilesCommandHandler), GetActualAsyncMethodName(), ex));
                throw ex;
            }
        }
    }
}
