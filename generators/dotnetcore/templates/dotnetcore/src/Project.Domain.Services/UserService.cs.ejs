/// <summary>
/// Service for managing users.
/// </summary>
public class UserService : IUserService
{
    /// <summary>
    /// Accessor for the HTTP context.
    /// </summary>
    private readonly IHttpContextAccessor _httpContextAccessor;
    
    /// <summary>
    /// Logger for the user service.
    /// </summary>
    private readonly ILogger<UserService> _log;
    
    /// <summary>
    /// Hasher for user passwords.
    /// </summary>
    private readonly IPasswordHasher<User> _passwordHasher;
    
    /// <summary>
    /// Manager for user roles.
    /// </summary>
    private readonly RoleManager<Role> _roleManager;
    
    /// <summary>
    /// Manager for users.
    /// </summary>
    private readonly UserManager<User> _userManager;
    
    /// <summary>
    /// Database context for the application.
    /// </summary>
    private readonly ApplicationDatabaseContext _databaseContext;

    /// <summary>
    /// Initializes a new instance of the <see cref="UserService"/> class.
    /// </summary>
    /// <param name="log">The logger for the user service.</param>
    /// <param name="userManager">The manager for users.</param>
    /// <param name="passwordHasher">The hasher for user passwords.</param>
    /// <param name="roleManager">The manager for user roles.</param>
    /// <param name="httpContextAccessor">The accessor for the HTTP context.</param>
    /// <param name="databaseContext">The database context for the application.</param>
    public UserService(ILogger<UserService> log, UserManager<User> userManager,
        IPasswordHasher<User> passwordHasher, RoleManager<Role> roleManager,
        IHttpContextAccessor httpContextAccessor, ApplicationDatabaseContext databaseContext)
    {
        _log = log;
        _userManager = userManager;
        _passwordHasher = passwordHasher;
        _roleManager = roleManager;
        _httpContextAccessor = httpContextAccessor;
        _databaseContext = databaseContext;
    }

    /// <summary>
    /// Creates a new user.
    /// </summary>
    /// <param name="userToCreate">The user to create.</param>
    /// <returns>The created user.</returns>
    /// <exception cref="ArgumentException">Thrown if the position ID is invalid.</exception>
    public virtual async Task<User> CreateUser(AddUserDto userToCreate)
    {
    
        Guid uuid = Guid.NewGuid();
    
        var position = await _databaseContext.Positions
                                .Include(p => p.PositionPermissions)
                                .ThenInclude(pp => pp.Permission)
                                .FirstOrDefaultAsync(p => p.Id == userToCreate.PositionId);
    
        if (position == null)
            throw new ArgumentException("Invalid PositionId");
    
        var user = new User
        {
            Login = userToCreate.Login.ToLowerInvariant(),
            FirstName = userToCreate.FirstName,
            LastName = userToCreate.LastName,
            Email = userToCreate.Email.ToLowerInvariant(),
            PasswordHash = _passwordHasher.HashPassword(null, userToCreate.Password),
            Activated = userToCreate.Activated,
            LangKey = userToCreate.LangKey,
            ImageUrl = userToCreate.ImageUrl,
            Position = position
        };
    
        var result = await _userManager.CreateAsync(user);
    
        return user;
    }

    /// <summary>
    /// Retrieves all managed users.
    /// </summary>
    /// <param name="pageable">The pagination options.</param>
    /// <returns>A page of managed users.</returns>
    public async Task<IPage<User>> GetAllManagedUsers(IPageable pageable)
    {
        <%_ if (databaseType === 'mongodb') { _%>
        IPage<User> users = await (_userManager.Users as IMongoQueryable<User>)
            .UsePageableAsync(pageable);
        UpdateUsersRoles(users.Content);
        return users;
        <%_ } else { _%>
        return await _userManager.Users
            .Include(it => it.UserRoles)
            .ThenInclude(r => r.Role)
            .UsePageableAsync(pageable);
        <%_ } _%>
    }

    /// <summary>
    /// Retrieves all public users.
    /// </summary>
    /// <param name="pageable">The pagination options.</param>
    /// <returns>A page of public users.</returns>
    public async Task<IPage<User>> GetAllPublicUsers(IPageable pageable)
    {
        <%_ if (databaseType === 'mongodb') { _%>
        IPage<User> users = await (_userManager.Users as IMongoQueryable<User>)
                 .Where(it => it.Activated == true && !string.IsNullOrEmpty(it.Id))
                 .UsePageableAsync(pageable);
        return users;
        <%_ } else { _%>
        return await _userManager.Users
            .Where(it => it.Activated == true && !string.IsNullOrEmpty(it.Id.ToString()))
            .UsePageableAsync(pageable);
        <%_ } _%>
    }

    /// <summary>
    /// Retrieves a user by login.
    /// </summary>
    /// <param name="login">The user's login.</param>
    /// <returns>The user with the specified login.</returns>
    public async Task<User> GetByLogin(string login)
    {
        <%_ if (databaseType === 'mongodb') { _%>
        User user = await (_userManager.Users as IMongoQueryable<User>)
            .Where(user => user.Login == login)
            .SingleOrDefaultAsync();
        UpdateUserRoles(user);
        return user;
        <%_ } else { _%>
        return await _userManager.Users
            .Where(user => user.Login == login)
            .Include(it => it.UserRoles)
            .ThenInclude(r => r.Role)
            .SingleOrDefaultAsync();
        <%_ } _%>
    }

    /// <summary>
    /// Updates a user.
    /// </summary>
    /// <param name="userToUpdate">The user to update.</param>
    /// <returns>The updated user.</returns>
    public virtual async Task<User> UpdateUser(UpdateUserDto userToUpdate)
    {
        //TODO use Optional
        var user = await _userManager.FindByIdAsync(userToUpdate.Id.ToString());
        user.Login = userToUpdate.Login.ToLower();
        user.UserName = userToUpdate.Login.ToLower();
        user.FirstName = userToUpdate.FirstName;
        user.LastName = userToUpdate.LastName;
        user.Email = userToUpdate.Email;
        user.Activated = userToUpdate.Activated;
        user.LangKey = userToUpdate.LangKey;
        user.ImageUrl = userToUpdate.ImageUrl;
        user.PositionId = userToUpdate.PositionId;
        user.Position= await _databaseContext.Positions
                                .Include(p => p.PositionPermissions)
                                .ThenInclude(pp => pp.Permission)
                                .FirstOrDefaultAsync(p => p.Id == userToUpdate.PositionId);
        await _userManager.UpdateAsync(user);
    
        return user;
    }

    /// <summary>
    /// Completes a password reset.
    /// </summary>
    /// <param name="newPassword">The new password.</param>
    /// <param name="key">The reset key.</param>
    /// <returns>The user with the updated password.</returns>
    public virtual async Task<User> CompletePasswordReset(string newPassword, string key)
    {
        _log.LogDebug($"Reset user password for reset key {key}");
        <%_ if (databaseType === 'mongodb') { _%>
        var user = await (_userManager.Users as IMongoQueryable<User>)
            .SingleOrDefaultAsync(it => it.ResetKey == key);
        <%_ } else { _%>
        var user = await _userManager.Users.SingleOrDefaultAsync(it => it.ResetKey == key);
        <%_ } _%>
        if (user == null || user.ResetDate <= DateTime.Now.Subtract(86400.Seconds())) return null;
        user.PasswordHash = _passwordHasher.HashPassword(user, newPassword);
        user.ResetKey = null;
        user.ResetDate = null;
        await _userManager.UpdateAsync(user);
        return user;
    }

    /// <summary>
    /// Requests a password reset.
    /// </summary>
    /// <param name="mail">The user's email.</param>
    /// <returns>The user with the reset key.</returns>
    public virtual async Task<User> RequestPasswordReset(string mail)
    {
        var user = await _userManager.FindByEmailAsync(mail);
        if (user == null) return null;
        user.ResetKey = RandomUtil.GenerateResetKey();
        user.ResetDate = DateTime.Now;
        await _userManager.UpdateAsync(user);
        return user;
    }

    /// <summary>
    /// Changes a user's password.
    /// </summary>
    /// <param name="currentClearTextPassword">The current password.</param>
    /// <param name="newPassword">The new password.</param>
    /// <returns></returns>
    /// <exception cref="InvalidPasswordException"></exception>
    public virtual async Task ChangePassword(string currentClearTextPassword, string newPassword)
    {
        var userName = _userManager.GetUserName(_httpContextAccessor.HttpContext.User);
        var user = await _userManager.FindByNameAsync(userName);
        if (user != null)
        {
            var currentEncryptedPassword = user.PasswordHash;
            var isInvalidPassword =
                _passwordHasher.VerifyHashedPassword(user, currentEncryptedPassword, currentClearTextPassword) !=
                PasswordVerificationResult.Success;
            if (isInvalidPassword) throw new InvalidPasswordException();

            var encryptedPassword = _passwordHasher.HashPassword(user, newPassword);
            user.PasswordHash = encryptedPassword;
            await _userManager.UpdateAsync(user);
            _log.LogDebug($"Changed password for User: {user}");
        }
    }

    /// <summary>
    /// Activates a user registration.
    /// </summary>
    /// <param name="key">The activation key.</param>
    /// <returns>The activated user.</returns>
    public virtual async Task<User> ActivateRegistration(string key)
    {
        _log.LogDebug($"Activating user for activation key {key}");
        <%_ if (databaseType === 'mongodb') { _%>
        var user = await (_userManager.Users as IMongoQueryable<User>)
            .SingleOrDefaultAsync(it => it.ActivationKey == key);
        <%_ } else { _%>
        var user = await _userManager.Users.SingleOrDefaultAsync(it => it.ActivationKey == key);
        <%_ } _%>

        if (user == null) return null;
        user.Activated = true;
        user.ActivationKey = null;
        await _userManager.UpdateAsync(user);
        _log.LogDebug($"Activated user: {user}");
        return user;
    }

    /// <summary>
    /// Registers a new user.
    /// </summary>
    /// <param name="userToRegister">The user to register.</param>
    /// <param name="password">The password.</param>
    /// <returns>The registered user.</returns>
    /// <exception cref="LoginAlreadyUsedException"></exception>
    /// <exception cref="EmailAlreadyUsedException"></exception>
    public virtual async Task<User> RegisterUser(User userToRegister, string password)
    {
        var existingUser = await _userManager.FindByNameAsync(userToRegister.Login.ToLower());
        if (existingUser != null)
        {
            var removed = await RemoveNonActivatedUser(existingUser);
            if (!removed) throw new LoginAlreadyUsedException();
        }

        existingUser = _userManager.Users.FirstOrDefault(it => it.Email == userToRegister.Email);
        if (existingUser != null)
        {
            var removed = await RemoveNonActivatedUser(existingUser);
            if (!removed) throw new EmailAlreadyUsedException();
        }

        var newUser = new User
        {
            Login = userToRegister.Login,
            // new user gets initially a generated password
            PasswordHash = _passwordHasher.HashPassword(null, password),
            FirstName = userToRegister.FirstName,
            LastName = userToRegister.LastName,
            Email = userToRegister.Email.ToLowerInvariant(),
            ImageUrl = userToRegister.ImageUrl,
            LangKey = userToRegister.LangKey,
            // new user is not active
            Activated = false,
            // new user gets registration key
            ActivationKey = RandomUtil.GenerateActivationKey()
            //TODO manage authorities
        };
        await _userManager.CreateAsync(newUser);
        _log.LogDebug($"Created Information for User: {newUser}");
        return newUser;
    }
    /// <summary>
    /// Updates a user's information.
    /// </summary>
    /// <param name="firstName">The first name.</param>
    /// <param name="lastName">The last name.</param>
    /// <param name="email">The email.</param>
    /// <param name="langKey">The language key.</param>
    /// <param name="imageUrl">The image URL.</param>
    /// <returns></returns>
    public virtual async Task UpdateUser(string firstName, string lastName, string email, string langKey, string imageUrl)
    {
        var userName = _userManager.GetUserName(_httpContextAccessor.HttpContext.User);
        var user = await _userManager.FindByNameAsync(userName);
        if (user != null)
        {
            user.FirstName = firstName;
            user.LastName = lastName;
            user.Email = email;
            user.LangKey = langKey;
            user.ImageUrl = imageUrl;
            await _userManager.UpdateAsync(user);
            _log.LogDebug($"Changed Information for User: {user}");
        }
    }

    /// <summary>
    /// Gets the current user with their roles.
    /// </summary>
    /// <returns>The user with their roles.</returns>
    public virtual async Task<User> GetUserWithUserRoles()
    {
        var userName = _userManager.GetUserName(_httpContextAccessor.HttpContext.User);
        if (userName == null) return null;
        return await GetUserWithUserRolesByName(userName);
    }

    /// <summary>
    /// Gets all authorities.
    /// </summary>
    /// <returns>A list of authorities.</returns>
    public virtual IEnumerable<string> GetAuthorities()
    {
        return _roleManager.Roles.Select(it => it.Name).AsQueryable();
    }
    /// <summary>
    /// Deletes a user.
    /// </summary>
    /// <param name="id">The user ID.</param>
    /// <returns></returns>
    public virtual async Task DeleteUser(string id)
    {
        var user = await _userManager.FindByIdAsync(id);
        if (user != null)
        {
        <%_ if (databaseType !== 'mongodb') { _%>
            await DeleteUserRoles(user);
        <%_ } _%>
            await _userManager.DeleteAsync(user);
            _log.LogDebug($"Deleted User: {user}");
        }
    }

    /// <summary>
    /// Gets a user with their roles by name.
    /// </summary>
    /// <param name="name">The user name.</param>
    /// <returns>The user with their roles.</returns>
    private async Task<User> GetUserWithUserRolesByName(string name)
    {
        <%_ if (databaseType === 'mongodb') { _%>
        User user = await (_userManager.Users as IMongoQueryable<User>)
            .SingleOrDefaultAsync(it => it.UserName == name);

        UpdateUserRoles(user);

        return user;
        <%_ } else { _%>
        return await _userManager.Users
            .Include(it => it.UserRoles)
            .ThenInclude(r => r.Role)
            .SingleOrDefaultAsync(it => it.UserName == name);
        <%_ } _%>
    }

    /// <summary>
    /// Removes a non-activated user.
    /// </summary>
    /// <param name="existingUser">The existing user.</param>
    /// <returns>True if the user was removed, false otherwise.</returns>
    private async Task<bool> RemoveNonActivatedUser(User existingUser)
    {
        if (existingUser.Activated) return false;

        await _userManager.DeleteAsync(existingUser);
        return true;
    }

    /// <summary>
    /// Creates user roles.
    /// </summary>
    /// <param name="user">The user.</param>
    /// <param name="roles">The roles.</param>
    /// <returns></returns>
    private async Task CreateUserRoles(User user, IEnumerable<string> roles)
    {
        if (roles == null || !roles.Any()) return;

        foreach (var role in roles) await _userManager.AddToRoleAsync(user, role);
        <%_ if (databaseType === 'mongodb') { _%>

        UpdateUserRoles(user);
        <%_ } _%>
    }

    /// <summary>
    /// Updates user roles.
    /// </summary>
    /// <param name="user">The user.</param>
    /// <param name="roles">The roles.</param>
    /// <returns></returns>
    private async Task UpdateUserRoles(User user, IEnumerable<string> roles)
    {
        var userRoles = await _userManager.GetRolesAsync(user);
        var rolesToRemove = userRoles.Except(roles).ToArray();
        var rolesToAdd = roles.Except(userRoles).Distinct().ToArray();
        await _userManager.RemoveFromRolesAsync(user, rolesToRemove);
        await _userManager.AddToRolesAsync(user, rolesToAdd);
        <%_ if (databaseType === 'mongodb') { _%>

        UpdateUserRoles(user);
        <%_ } _%>
    }
    <%_ if (databaseType === 'mongodb') { _%>

    private void UpdateUsersRoles(IEnumerable<User> users)
    {
        Dictionary<string, Role> roles = _roleManager.Roles.ToDictionary(role => role.Id);
        foreach (User user in users)
        {
            user.UserRoles = user.Roles.Select(role => new UserRole() { UserId = user.Id, Role = roles[role] }).ToList();
        }
    }

    private void UpdateUserRoles(User user)
    {
        if (user == null)
        {
            return;
        }

        Dictionary<string, Role> roles = _roleManager.Roles.ToDictionary(role => role.Id);
        user.UserRoles = user.Roles.Select(role => new UserRole() { UserId = user.Id, Role = roles[role] }).ToList();
    }
    <%_ } else { _%>

    /// <summary>
    /// Deletes a user's roles.
    /// </summary>
    /// <param name="user">The user.</param>
    /// <returns></returns>
    private async Task DeleteUserRoles(User user)
    {
        var roles = await _userManager.GetRolesAsync(user);
        await _userManager.RemoveFromRolesAsync(user, roles);
    }
    <%_ } _%>

    /// <summary>
    /// Gets the connected user.
    /// </summary>
    /// <returns>The connected user.</returns>
    public async Task<UserDetailDto> GetConnectedUser()
    {
        var user = _httpContextAccessor.HttpContext?.User;
    
        if (user == null || !user.Identity.IsAuthenticated)
        {
            // Handle the case where the user is not authenticated
            return null;
        }
    
        // Extract user information from claims
        var userName = user.Identity.Name;
    
        UserDetailDto currentUser = await _databaseContext.Users
                .Select(u => new UserDetailDto
                {
                    Id = u.Id,
                    FirstName = u.FirstName,
                    LastName = u.LastName,
                    Activated = u.Activated,
                    Email = u.Email,
                    LangKey = u.LangKey,
                    Login = u.Login,
                    Position = new PositionDto
                    {
                        Id = u.Position.Id,
                        Name = u.Position.Name,
                        IsAdmin = u.Position.IsAdmin,
                        Permissions = u.Position.PositionPermissions
                        .Select(pp => pp.Permission.Name)
                        .ToArray()
                    }
                })
                .FirstOrDefaultAsync(u => u.Login == userName);
    
    
        // Create and return the User object with Position included
        return currentUser;
    }

    /// <summary>
    /// Checks if a position is assigned to a user.
    /// </summary>
    /// <param name="positionId">The position ID.</param>
    /// <returns>True if the position is assigned, false otherwise.</returns>
    public async Task<bool> IsPositionAssignedToUserAsync(int positionId)
    {
        return await _databaseContext.Users.AnyAsync(u => u.PositionId == positionId && u.DeletedAt == null);
    }
}
