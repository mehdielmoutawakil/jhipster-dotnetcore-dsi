using <%= namespace %>.Domain.Entities;
using Microsoft.AspNetCore.Identity;

namespace <%= namespace %>.Security;

/// <summary>
/// Custom password hasher using BCrypt.
/// </summary>
public class BCryptPasswordHasher : IPasswordHasher<User>
{
    /// <summary>
    /// Hashes a password using BCrypt.
    /// </summary>
    /// <param name="user">User instance.</param>
    /// <param name="password">Password to hash.</param>
    /// <returns>Hashed password.</returns>
    public string HashPassword(User user, string password)
    {
        return BCrypt.Net.BCrypt.HashPassword(password);
    }
    
    /// <summary>
    /// Verifies a hashed password against a provided password.
    /// </summary>
    /// <param name="user">User instance.</param>
    /// <param name="hashedPassword">Hashed password.</param>
    /// <param name="providedPassword">Provided password to verify.</param>
    /// <returns>Password verification result.</returns>
    public PasswordVerificationResult VerifyHashedPassword(User user, string hashedPassword,
        string providedPassword)
    {
        return BCrypt.Net.BCrypt.Verify(providedPassword, hashedPassword)
            ? PasswordVerificationResult.Success
            : PasswordVerificationResult.Failed;
    }
}
