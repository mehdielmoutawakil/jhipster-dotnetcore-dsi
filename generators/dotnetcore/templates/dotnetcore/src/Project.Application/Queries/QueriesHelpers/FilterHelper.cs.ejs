using System;
using System.Linq;
using System.Linq.Expressions;

namespace <%= namespace %>.Application.Queries
{
    public static class FilterHelper
    {
        public static IQueryable<T> ApplyFilter<T>(IQueryable<T> query, SearchQuery filter)
        {
            try
            {
                var parameter = Expression.Parameter(typeof(T), "e");
                var property = Expression.Property(parameter, filter.Field);

                // Determine the underlying type of the property (handling nullable types)
                var propertyType = property.Type;
                var underlyingType = Nullable.GetUnderlyingType(propertyType) ?? propertyType;

                // Convert the filter value to the appropriate type
                object convertedValue;
                try
                {
                    convertedValue = Convert.ChangeType(filter.Value, underlyingType);
                }
                catch (Exception ex)
                {
                    throw new InvalidOperationException($"Error converting filter value to type {underlyingType}", ex);
                }

                // Create a comparison expression based on the operator
                Expression comparison;
                var constant = Expression.Constant(convertedValue, underlyingType);

                if (property.Type.IsGenericType && property.Type.GetGenericTypeDefinition() == typeof(Nullable<>))
                {
                    var hasValue = Expression.Property(property, "HasValue");
                    var value = Expression.Property(property, "Value");

                    comparison = CreateComparisonExpression(filter.Operator.ToLower(), value, constant, underlyingType);

                    if (comparison != null)
                    {
                        comparison = Expression.AndAlso(hasValue, comparison);
                    }
                }
                else
                {
                    comparison = CreateComparisonExpression(filter.Operator.ToLower(), property, constant, underlyingType);
                }

                if (comparison == null)
                {
                    throw new InvalidOperationException($"Unsupported operator: {filter.Operator}");
                }

                var lambda = Expression.Lambda<Func<T, bool>>(comparison, parameter);
                return query.Where(lambda);
            }
            catch (Exception ex)
            {
                // Log detailed information for debugging
                throw;
            }
        }

        private static Expression CreateComparisonExpression(string op, Expression left, Expression right, Type underlyingType)
        {
            switch (op)
            {
                case "eq":
                    return Expression.Equal(left, right);
                case "neq":
                    return Expression.NotEqual(left, right);
                case "gt":
                    return Expression.GreaterThan(left, right);
                case "gte":
                    return Expression.GreaterThanOrEqual(left, right);
                case "lt":
                    return Expression.LessThan(left, right);
                case "lte":
                    return Expression.LessThanOrEqual(left, right);
                case "in":
                    if (underlyingType == typeof(string))
                    {
                        return Expression.Call(left, typeof(string).GetMethod("Contains", new[] { typeof(string) }), right);
                    }
                    throw new InvalidOperationException("Operator 'in' is only supported for string properties.");
                case "not in":
                    if (underlyingType == typeof(string))
                    {
                        var containsExpression = Expression.Call(left, typeof(string).GetMethod("Contains", new[] { typeof(string) }), right);
                        return Expression.Not(containsExpression);
                    }
                    throw new InvalidOperationException("Operator 'not in' is only supported for string properties.");
                case "startswith":
                    if (underlyingType == typeof(string))
                    {
                        return Expression.Call(left, typeof(string).GetMethod("StartsWith", new[] { typeof(string) }), right);
                    }
                    throw new InvalidOperationException("Operator 'startswith' is only supported for string properties.");
                case "endswith":
                    if (underlyingType == typeof(string))
                    {
                        return Expression.Call(left, typeof(string).GetMethod("EndsWith", new[] { typeof(string) }), right);
                    }
                    throw new InvalidOperationException("Operator 'endswith' is only supported for string properties.");
                case "contains":
                    if (underlyingType == typeof(string))
                    {
                        return Expression.Call(left, typeof(string).GetMethod("Contains", new[] { typeof(string) }), right);
                    }
                    throw new InvalidOperationException("Operator 'contains' is only supported for string properties.");
                default:
                    return null;
            }
        }
    }

    public static class SortHelper
    {
        public static IQueryable<T> ApplySort<T>(IQueryable<T> query, string sort)
        {
            if (!string.IsNullOrWhiteSpace(sort))
            {
                var sortParams = sort.Split(',');
                if (sortParams.Length == 2)
                {
                    var sortField = sortParams[0];
                    var sortDirection = sortParams[1].ToLower();

                    if (sortDirection == "asc")
                    {
                        query = query.OrderByDynamic(sortField, true);
                    }
                    else if (sortDirection == "desc")
                    {
                        query = query.OrderByDynamic(sortField, false);
                    }
                    else
                    {
                        throw new InvalidOperationException($"Unsupported sort direction: {sortDirection}");
                    }
                }
                else
                {
                    throw new InvalidOperationException("Sort parameter format is invalid. Expected format is 'field,direction'.");
                }
            }

            return query;
        }
    }

    public static class PagingHelper
    {
        public static IQueryable<T> ApplyPaging<T>(IQueryable<T> query, int pageNumber = 1, int pageSize = 10)
        {
            if (pageNumber >= 1 && pageSize >= 1)
            {
                query = query
                    .Skip((pageNumber - 1) * pageSize)
                    .Take(pageSize);
            }
            return query;
        }
    }
}
