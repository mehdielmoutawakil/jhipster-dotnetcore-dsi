<%
let hasDto = dto === 'mapstruct';
%>
<%_ if (hasDto) { _%>
using AutoMapper;
using System.Linq;
<%_ } _%>
using <%= namespace %>.Domain.Entities;
using <%= namespace %>.Domain.Repositories.Interfaces;
using MediatR;
using System.Threading;
using System.Threading.Tasks;
using System;
using System.Runtime.CompilerServices;
using Serilog;
using Application.Utility;

namespace <%= namespace %>.Application.Commands;

/// <summary>
/// <%= pascalizedEntityClass %> create request class handler
/// </summary>
public class <%= pascalizedEntityClass %>CreateCommandHandler : IRequestHandler<<%= pascalizedEntityClass %>CreateCommand, <%= pascalizedEntityClass %>>
{
    private I<%= pascalizedEntityClass %>Repository _<%= camelCasedEntityClass %>Repository;
    <%_ if (hasDto) { _%>
    private readonly IMapper _mapper;
    <%_ } _%>

    /// <summary>
    /// Variable used to get API method name, in async calls
    /// </summary>
    /// <param name="name"></param>
    /// <returns></returns>
    static string GetActualAsyncMethodName([CallerMemberName] string name = null) => name;

    /// <summary>
    /// <%= pascalizedEntityClass %>CreateCommandHandler parameterized constructor
    /// </summary>
    /// <param name="activityRepository"></param>
    public <%= pascalizedEntityClass %>CreateCommandHandler(
        <%_ if (hasDto) { _%>
        IMapper mapper,
        <%_ } _%>
        I<%= pascalizedEntityClass %>Repository <%= camelCasedEntityClass %>Repository)
    {
        <%_ if (hasDto) { _%>
        _mapper = mapper;
        <%_ } _%>
        _<%= camelCasedEntityClass %>Repository = <%= camelCasedEntityClass %>Repository;
    }

    /// <summary>
    /// Handler Method
    /// </summary>
    /// <param name="command"></param>
    /// <param name="cancellationToken"></param>
    /// <returns></returns>
    public async Task<<%= pascalizedEntityClass %>> Handle(<%= pascalizedEntityClass %>CreateCommand command, CancellationToken cancellationToken)
    {
        // Variables declaration
        <%= pascalizedEntityClass %> entity = new <%= pascalizedEntityClass %>();

        try
        {
            <%_ if (hasDto) { _%>
            <%= pascalizedEntityClass %> <%= camelCasedEntityClass %> = _mapper.Map<<%= pascalizedEntityClass %>>(command.<%= hasDto ? asDto(pascalizedEntityClass) : pascalizedEntityClass %>);
            entity = await _<%= camelCasedEntityClass %>Repository.CreateOrUpdateAsync(<%= camelCasedEntityClass %>);
            <%_ } else { _%>
            entity = await _<%= camelCasedEntityClass %>Repository.CreateOrUpdateAsync(command.<%= pascalizedEntityClass %>);
            <%_ } _%>
            await _<%= camelCasedEntityClass %>Repository.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Log.Error(CommHelper.LogError(typeof(<%= pascalizedEntityClass %>CreateCommandHandler), GetActualAsyncMethodName(), ex));
            throw ex;
        }

        return entity;
    }
}
