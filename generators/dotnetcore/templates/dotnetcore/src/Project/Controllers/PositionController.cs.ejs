using MediatR;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Logging;
using System;
using System.Collections.Generic;
using System.Threading.Tasks;
using <%= namespace %>.Application.Queries;
using <%= namespace %>.Domain.Entities;
using <%= namespace %>.Application.Commands;
using <%= namespace %>.Dto;

namespace <%= namespace %>.Controllers
{
    [Authorize]
    [Route("api/Positions")]
    [ApiController]
    public class PositionController : ControllerBase
    {
        private readonly ILogger<PositionController> _log;
        private readonly IMediator _mediator;

        /// <summary>
        /// Contructor
        /// </summary>
        /// <param name="log"></param>
        /// <param name="mediator"></param>
        public PositionController(ILogger<PositionController> log, IMediator mediator)
        {
            _log = log;
            _mediator = mediator;
        }

        /// <summary>
        /// Create new Position
        /// </summary>
        /// <param name="positionDto"></param>
        /// <returns></returns>
        [HttpPost]
        public async Task<ActionResult<PositionDto>> CreatePosition([FromBody] PositionDto positionDto)
        {
            _log.LogDebug($"REST request to save position : {positionDto}");
          
            var position = await _mediator.Send(new PositionCreateCommand { positionDto = positionDto });
            return CreatedAtAction(nameof(CreatePosition), position);
           
        }

        /// <summary>
        /// Update Position informations
        /// </summary>
        /// <param name="positionDto"></param>
        /// <returns></returns>
        [HttpPut]
        public async Task<ActionResult<PositionDto>> UpdatePosition([FromBody] PositionDto positionDto)
        {
            _log.LogDebug($"REST request to update position : {positionDto}");
      
            var position = await _mediator.Send(new PositionUpdateCommand { positionDto = positionDto });
            return Ok(position);
      
        }

        /// <summary>
        /// Delete Position by ID
        /// </summary>
        /// <param name="id">Position ID</param>
        /// <returns></returns>
        [HttpDelete("{id}")]
        public async Task<IActionResult> DeletePosition(int id)
        {
            _log.LogDebug($"REST request to delete position with ID: {id}");
        
            try
            {
                var result = await _mediator.Send(new PositionDeleteCommand { PositionId = id });
                if (result)
                {
                    return NoContent();
                }
                else
                {
                    return BadRequest("Position is assigned to a user and cannot be deleted.");
                }
            }
            catch (ArgumentException ex)
            {
                return BadRequest(ex.Message);
            }
        }

        /// <summary>
        /// Get List of Positions with pagination, sort and filters
        /// </summary>
        /// <param name="queryParameters"></param>
        /// <returns></returns>
        [HttpGet("search")]
        public async Task<ActionResult<PaginatedResult<Position>>> Search([FromQuery] IDictionary<string, string> queryParameters)
        {
            _log.LogDebug("REST request to get filtered Position");

            try
            {
                var (filters, pageNumber, pageSize, sort) = QueryParameterHelper.ProcessQueryParameters(queryParameters);

                var query = new PositionSearchQuery
                {
                    Filters = filters,
                    PageNumber = pageNumber,
                    PageSize = pageSize,
                    Sort = sort
                };

                var result = await _mediator.Send(query);

                return Ok(result);
            }
            catch (ArgumentException ex)
            {
                return BadRequest(ex.Message);
            }
        }
    }
}
